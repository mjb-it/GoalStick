[Unit]
Description=GoalStick NHL Goal Light Service
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
NotifyAccess=all
User=root
Group=root
WorkingDirectory=__INSTALL_DIR__/PythonSrc
Environment=PATH=__INSTALL_DIR__/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__INSTALL_DIR__/.venv/bin/python main.py

# Restart policy - always restart on failure
Restart=always
RestartSec=10

# Watchdog - systemd will kill and restart if no ping within 60s.
# main.py starts the watchdog thread before anything else so every mode
# (normal, waiting for WiFi, pairing) keeps pinging.
WatchdogSec=60
TimeoutStopSec=20

# Resource limits to prevent runaway processes
MemoryMax=256M
CPUQuota=50%

# Security hardening.
# The service still runs as root: it needs raw GPIO, the Bluetooth adapter,
# /etc/NetworkManager, systemctl restart and reboot. Everything below is safe
# with that model and does not interfere with apt/pip updates.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
