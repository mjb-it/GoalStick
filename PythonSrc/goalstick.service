[Unit]
Description=GoalStick NHL Goal Light Service
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
User=matt
Group=matt
WorkingDirectory=/home/matt/workspace/GoalStick/PythonSrc
Environment=PATH=/home/matt/workspace/GoalStick/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/matt/workspace/GoalStick/.venv/bin/python main.py
Restart=always
RestartSec=10

# Give access to Bluetooth and serial
SupplementaryGroups=bluetooth dialout

[Install]
WantedBy=multi-user.target
